{
  "name": "memgrep",
  "version": "1.6.7",
  "description": "Local agent memory, coding loop, Cursor from Telegram, scheduled playbooks, and MCP tools.",
  "keywords": [
    "semantic-search",
    "vector-search",
    "embeddings",
    "rag",
    "hnsw",
    "transformers",
    "local-first",
    "offline",
    "mcp",
    "agent-memory",
    "cursor",
    "cursor-agent",
    "claude-code",
    "telegram",
    "telegram-bot",
    "coding-agent",
    "remote-agent",
    "cron",
    "scheduled-jobs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darula-hpp/memgrep.git"
  },
  "homepage": "https://github.com/darula-hpp/memgrep#readme",
  "bugs": {
    "url": "https://github.com/darula-hpp/memgrep/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "memgrep": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "start": "bash scripts/start-all.sh",
    "stop": "bash scripts/stop-all.sh"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "hnswlib-node": "^3.0.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "nunjucks": "^3.2.4",
    "picocolors": "^1.1.1",
    "undici": "^6.27.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/nunjucks": "^3.2.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
