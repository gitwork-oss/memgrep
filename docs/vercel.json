{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "memgrep-docs.vercel.app"
        }
      ],
      "destination": "https://memgrep.gitwork.dev/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "memgrep.getuigen.dev"
        }
      ],
      "destination": "https://memgrep.gitwork.dev/:path*",
      "permanent": true
    }
  ]
}
